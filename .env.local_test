# s3pulse .env for LOCAL TESTS ONLY (targets the selftest SeaweedFS, never real storage).
# Credentials match the s3-selftest service in docker-compose.yml.
#
# Usage:
#   make selftest                                   # one-shot: SeaweedFS + runner, then teardown
#   docker compose --profile selftest up --detach s3-selftest   # keep SeaweedFS running...
#   make run                                        # ...and run the probe profile against it
#   make run PROFILE=load
#   DRY_RUN=true SINK_TYPE=pushgateway make run     # inspect what a sink would send

# ---- Target: local SeaweedFS (S3) server from the selftest profile ----------------------------
S3_ENDPOINT=s3-selftest:9000
S3_ACCESS_KEY=s3pulse-selftest
S3_SECRET_KEY=s3pulse-selftest-secret
S3_TLS=false
S3_TLS_INSECURE=false
S3_REGION=us-east-1
S3_BUCKET=s3pulse-selftest
S3_LOOKUP=path

# ---- Profile: short runs so the whole probe takes well under a minute ---------
PROFILE=probe
DEFAULT_DURATION=5
DEFAULT_CONCURRENCY=2

# ---- Sink: stub (stdout + /results/latest), no external services -------------
SINK_TYPE=stub
SINK_URL=http://127.0.0.1:9091
SINK_HTTP_BEARER_TOKEN=

# ---- Run identity -------------------------------------------------------------
RUN_LABEL=local
RUN_INTERVAL_SECONDS=
DRY_RUN=false

# ---- Advanced -----------------------------------------------------------------
WARP_EXTRA_ARGS=
WARP_IMAGE=minio/warp:latest
SELFTEST_S3_IMAGE=chrislusf/seaweedfs:latest
S3PULSE_VERSION=0.1.0
SELFTEST_DURATION=5
