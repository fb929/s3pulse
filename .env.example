# s3pulse configuration. Copy to .env and edit. Never commit .env.
#
# ---- Target S3-compatible endpoint (NOT AWS S3) -------------------------------
# host:port only, no scheme. TLS is controlled by S3_TLS.
S3_ENDPOINT=s3.example.internal:9000
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
# true|false. Use https when true.
S3_TLS=false
# true|false. Skip certificate verification (self-signed certs). Passed as `warp --insecure`.
S3_TLS_INSECURE=false
# Many S3-compatible stores ignore the region but still require some value.
S3_REGION=us-east-1
# DEDICATED bucket. warp deletes ALL objects in it before and after every scenario.
S3_BUCKET=s3pulse
# path|dns. path = path-style addressing (default; virtual-hosted style is rarely
# supported by S3-compatible stores). dns = virtual-hosted style.
S3_LOOKUP=path

# ---- Profile ------------------------------------------------------------------
# probe = lightweight monitoring (put_small, get_medium, list_1k; low concurrency, short).
# load  = full scenario set with higher concurrency and duration.
PROFILE=probe
# Defaults used when a scenario (or its per-profile override) does not set them.
# Seconds.
DEFAULT_DURATION=30
DEFAULT_CONCURRENCY=4

# ---- Sink ---------------------------------------------------------------------
# stub|pushgateway|http_json
SINK_TYPE=stub
# pushgateway: base URL, e.g. http://pushgateway:9091
# http_json:   full URL to POST to, e.g. https://collector.example.internal/s3pulse
SINK_URL=
# Optional: sent as "Authorization: Bearer <token>" by the http_json sink.
SINK_HTTP_BEARER_TOKEN=

# ---- Run identity -------------------------------------------------------------
# Stable free-form label identifying the target/environment, e.g. prod-s3-eu.
# Used as the Prometheus `instance` label. Allowed chars: A-Z a-z 0-9 . _ -
RUN_LABEL=default
# If set, the runner loops forever and sleeps this many seconds after each full run.
# Leave empty to run once and exit. See docker-compose.monitoring.yml.
RUN_INTERVAL_SECONDS=
# true|false. Sinks print the exact request (URL, headers, body) instead of sending it.
DRY_RUN=false

# ---- Results ------------------------------------------------------------------
# Host directory mounted at /results in the runner (bind mount). Relative paths are
# resolved against this directory. Example: /Users/me/AI/Claude/outputs/s3pulse/results
RESULTS_PATH=./results

# ---- Advanced -----------------------------------------------------------------
# Extra warp flags appended to EVERY scenario (whitespace separated), e.g. compatibility
# switches for a particular S3 implementation: --disable-multipart --md5 --disable-sha256-payload
WARP_EXTRA_ARGS=
# Image overrides (build args / selftest).
WARP_IMAGE=minio/warp:latest
SELFTEST_S3_IMAGE=chrislusf/seaweedfs:latest
S3PULSE_VERSION=0.1.0
# Duration (seconds) used by `make selftest`.
SELFTEST_DURATION=5
